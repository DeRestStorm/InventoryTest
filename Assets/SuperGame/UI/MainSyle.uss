VisualElement {
    --slot-icon-image: url("project://database/Assets/Content/grass_top2_gray.png?fileID=2800000&guid=5b18cbf72a9983a4fbd8206d490105df&type=3#grass_top2_gray");
    --inventory-panel-width: 320px;
}

.background-black {
    background-color: rgba(0, 0, 0, 0.4);
}

.container-absolute {
    right: 0;
    top: 0;
    bottom: 0;
    left: 0;
}

.drop-zone {
    flex-grow: 1;
    border-width: 2px;
    border-radius: 8px;
    margin: 4px;
    position: absolute;
    right: var(--inventory-panel-width);
    top: 0;
    bottom: 0;
    left: 0;
}

.drop-zone--highlight {
    border-color: rgba(255, 200, 0, 0.8);
}

.right-panel {
    flex-grow: 1;
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    width: var(--inventory-panel-width);
}

.take-text {
    -unity-text-align: middle-center;
    color: white;
    position: absolute;
    font-size: 30px;
}

.inventory-grid {
    flex-direction: row;
    flex-wrap: wrap;
    padding: 8px;
    justify-content: center;
    align-items: flex-start;
    align-content: flex-start;
}

.inventory-slot {
    width: 83px;
    height: 83px;
    background-color: rgba(0, 0, 0, 0.5);
    border-radius: 14px;
    margin: 4px;
    justify-content: center;
    align-items: center;
}

.inventory-slot__icon {
    width: 70px;
    height: 70px;
    border-radius: 8px;
    -unity-background-image-tint-color: rgb(142, 72, 72);
}

.inventory-slot__item {
    background-image: var(--slot-icon-image);
}

.inventory-slot__name {
    color: white;
    font-size: 14px;
    -unity-text-align: middle-center;
    overflow: hidden;
    white-space: normal;
    max-width: 66px;
    text-shadow: 1px 1px 1px rgb(0, 0, 0);
}

.inventory-slot__count {
    position: absolute;
    right: 4px;
    bottom: 2px;
    color: white;
    font-size: 14px;
    -unity-font-style: bold;
}

.inventory-slot--highlight {
    border-width: 2px;
    border-color: rgba(255, 200, 0, 0.8);
}

.drag-ghost {
    position: absolute;
    width: 70px;
    height: 70px;
    border-radius: 14px;
    opacity: 0.7;
    background-image: var(--slot-icon-image);
}
